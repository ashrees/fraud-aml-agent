# Copy to .env — defaults match docker-compose.yml

# Kafka / Redpanda (host-side listener)
KAFKA_BROKERS=localhost:19092
TOPIC_TXNS=raw_txns
TOPIC_REFERENCE=raw_reference

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aml-raw
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Postgres
POSTGRES_USER=aml
POSTGRES_PASSWORD=aml
POSTGRES_DB=aml
DATABASE_URL=postgres://aml:aml@localhost:5432/aml

# Simulator
SIM_CUSTOMERS=500
SIM_TPS=50              # transactions per second
SIM_SUSPICIOUS_RATE=0.02 # share of customers running a laundering pattern
SIM_SEED=42             # same seed => same customers and same patterns
SIM_DURATION_SEC=0      # 0 = run forever
SIM_BACKFILL_DAYS=30    # history emitted before going live
SIM_TXNS_PER_CUSTOMER_PER_DAY=1.5
SIM_LIVE_SCENARIO_EVERY_SEC=60  # start a laundering scenario this often in live mode
SIM_LIVE_SCENARIO_SPAN_MIN=10   # compress each live scenario into N minutes

# Ingest consumer
INGEST_BATCH_SIZE=1000
INGEST_FLUSH_MS=10000
